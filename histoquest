function renderPanel() {
  const body   = document.getElementById('panelBody');
  const search = (document.getElementById('panelSearch').value||'').toLowerCase();
  const count  = document.getElementById('panelCount');
  body.innerHTML = '';
  let visible = 0;
  const custom = getCustomFigures();
  getAllFigures().forEach(f => {
    if (search && !f.name.toLowerCase().includes(search)) return;
    if (smartFilterOn) {
      let bad = false;
      for (const [a,v] of Object.entries(knownCorrect)) { if (f[a]!==v){bad=true;break;} }
      if (!bad && guesses.find(g=>g.name===f.name)) bad = true;
      if (bad) return;
    }
    const isCustom = custom.some(c => c.name === f.name);
    const card = document.createElement('div');
    card.className = 'figure-card';
    card.innerHTML = `<h3>${f.name}${isCustom?'<span class="custom-badge">CUSTOM</span>':''}</h3>
      <div class="figure-tags">${[f.gender,f.country,f.century,f.occupation,f.continent,f.religion].map(t=>`<span class="tag">${t}</span>`).join('')}</div>`;
    body.appendChild(card);
    visible++;
  });
  count.textContent = `Showing ${visible} of ${getAllFigures().length} figures`;
}
