// AUTOCOMPLETE
// ════════════════════════════════════════════════════════════════════════════
function onInputChange() {
  const val = document.getElementById('guessInput').value.trim().toLowerCase();
  const box = document.getElementById('autocomplete');
  acIndex = -1;
  if (!val) { closeAutocomplete(); return; }
  const guessedNames = guesses.map(g => g.name.toLowerCase());
  const matches = getAllFigures().filter(f => f.name.toLowerCase().includes(val) && !guessedNames.includes(f.name.toLowerCase()));
  if (!matches.length) { closeAutocomplete(); return; }
  box.innerHTML = '';
  matches.slice(0, 10).forEach(f => {
    const item = document.createElement('div');
    item.className = 'autocomplete-item';
    item.textContent = f.name;
    item.addEventListener('mousedown', () => selectFigure(f.name));
    box.appendChild(item);
  });
  box.style.display = 'block';
}
function onInputKeyDown(e) {
  const box = document.getElementById('autocomplete');
  const items = box.querySelectorAll('.autocomplete-item');
  if (!items.length) { if (e.key==='Enter') submitGuess(); return; }
  if (e.key==='ArrowDown') { e.preventDefault(); acIndex=Math.min(acIndex+1,items.length-1); items.forEach((el,i)=>el.classList.toggle('active',i===acIndex)); }
  else if (e.key==='ArrowUp') { e.preventDefault(); acIndex=Math.max(acIndex-1,-1); items.forEach((el,i)=>el.classList.toggle('active',i===acIndex)); }
  else if (e.key==='Enter') { e.preventDefault(); if(acIndex>=0&&items[acIndex]) selectFigure(items[acIndex].textContent); else submitGuess(); }
  else if (e.key==='Escape') closeAutocomplete();
}
function selectFigure(name) { document.getElementById('guessInput').value = name; closeAutocomplete(); }
function closeAutocomplete() { const b=document.getElementById('autocomplete'); b.style.display='none'; b.innerHTML=''; acIndex=-1; }
document.addEventListener('click', e => { if (!e.target.closest('#inputSection')) closeAutocomplete(); });

// ════════════════════════════════════════════════════════════════════════════
// GUESS LOGIC
// ════════════════════════════════════════════════════════════════════════════
function submitGuess() {
  if (gameOver) return;
  const inputEl = document.getElementById('guessInput');
  const raw = inputEl.value.trim();
  if (!raw) { showToast('Please type a name!'); return; }
  const figure = getAllFigures().find(f => f.name.toLowerCase() === raw.toLowerCase());
  if (!figure) { showToast('Unknown figure. Use the autocomplete!'); return; }
  if (guesses.find(g => g.name.toLowerCase() === figure.name.toLowerCase())) { showToast('Already guessed!'); return; }
  guesses.push(figure);
  inputEl.value = '';
  closeAutocomplete();
  getCurrentAttrs().forEach(attr => { if (figure[attr] === target[attr]) knownCorrect[attr] = target[attr]; });
  renderRow(figure);
  updateTriesDisplay();
  if (document.getElementById('listPanel').classList.contains('open') && smartFilterOn) renderPanel();
  if (figure.name === target.name) endGame(true);
  else if (guesses.length >= maxTries) endGame(false);
}

function renderRow(figure) {
  const board = document.getElementById('guessBoard');
  const row   = document.createElement('div');
  row.className = 'guess-row';
  const nc = document.createElement('div');
  nc.className = `cell ${figure.name===target.name?'correct':'wrong'}`;
  nc.style.setProperty('--i',0); nc.textContent = figure.name;
  row.appendChild(nc);
  getCurrentAttrs().forEach((attr,i) => {
    const c = document.createElement('div');
    c.className = `cell ${figure[attr]===target[attr]?'correct':'wrong'}`;
    c.style.setProperty('--i',i+1); c.textContent = figure[attr];
    row.appendChild(c);
  });
  board.appendChild(row);
  row.scrollIntoView({behavior:'smooth',block:'nearest'});
}

function endGame(won) {
  gameOver = true;
  document.getElementById('inputSection').style.display = 'none';
  const banner = document.getElementById('resultBanner');
  banner.style.display = 'block';
  banner.className = won ? 'win' : 'lose';

  const isDaily = currentMode.startsWith('daily-');
  if (isDaily) {
    const today = todayStr();
    saveDailyResult(currentDailyType, today, { guesses: guesses.map(g=>g.name), won });
    updateStreak(currentDailyType, won);
    const shareText = buildShareText(currentDailyType, today, guesses.map(g=>g.name), won, maxTries);
    document.getElementById('resultShareText').textContent = shareText;
    document.getElementById('resultShareBox').style.display = 'block';
    setTimeout(startCountdown, 700);
  } else {
    // Track free mode stats
    const fs = getFreeStats();
    fs.played = (fs.played||0) + 1;
    if (won) fs.wins = (fs.wins||0) + 1;
    saveFreeStats(fs);
    document.getElementById('resultShareBox').style.display = 'none';
  }

  const actions = document.getElementById('resultActions');
  if (isDaily) {
    actions.innerHTML = `<button class="btn-secondary" onclick="copyShare('result')">📋 Share Result</button>
      <button class="btn-secondary" onclick="returnToMenu()">← Menu</button>`;
  } else {
    actions.innerHTML = `<button class="btn-secondary" onclick="startGame(currentMode)">Play Again</button>
      <button class="btn-secondary" onclick="returnToMenu()">← Menu</button>`;
  }

  document.getElementById('resultEmoji').textContent = won ? '🏆' : '💀';
  document.getElementById('resultTitle').textContent = won ? `Magnificent! You got it in ${guesses.length}!` : 'Defeated! The answer was…';
  document.getElementById('resultMsg').textContent   = won
    ? `The answer was ${target.name}. A true historian!`
    : `${target.name} — ${target.occupation} from ${target.country} (${target.century}).`;
  setTimeout(() => banner.scrollIntoView({behavior:'smooth',block:'nearest'}), 700);
}

