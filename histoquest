  document.getElementById('guessInput').value              = '';
  updateTriesDisplay();
}

function replayBoard(guessNames, fig, showCols) {
  const board = document.getElementById('guessBoard');
  board.innerHTML = '';
  if (showCols) document.getElementById('colHeader').style.display = '';
  guessNames.forEach(name => {
    const g = getAllFigures().find(f => f.name === name);
    if (!g) return;
    const row = document.createElement('div');
    row.className = 'guess-row';
    const nc = document.createElement('div');
    nc.className = `cell ${g.name === fig.name ? 'correct' : 'wrong'}`;
    nc.style.setProperty('--i', 0); nc.textContent = g.name;
    row.appendChild(nc);
    getCurrentAttrs().forEach((attr, i) => {
      const c = document.createElement('div');
      c.className = `cell ${g[attr] === fig[attr] ? 'correct' : 'wrong'}`;
      c.style.setProperty('--i', i+1); c.textContent = g[attr];
      row.appendChild(c);
    });
    board.appendChild(row);
  });
}

function startCountdown() {
  if (countdownInterval) clearInterval(countdownInterval);
  function tick() {
    const now = new Date(), next = new Date(now);
    next.setDate(next.getDate()+1); next.setHours(0,0,0,0);
    const d = next - now;
    const h = String(Math.floor(d/3600000)).padStart(2,'0');
    const m = String(Math.floor((d%3600000)/60000)).padStart(2,'0');
    const s = String(Math.floor((d%60000)/1000)).padStart(2,'0');
    const el = document.getElementById('countdownDisplay');
    if (el) el.textContent = `${h}:${m}:${s}`;
  }
  tick(); countdownInterval = setInterval(tick, 1000);
}

