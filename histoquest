function populateStats() {
  const today = todayStr();
  const sh = getStats('hard'), se = getStats('easy');
  const fs = getFreeStats();

  // ── Flame streaks ──
  const hardPlayedToday = !!getDailyResult('hard', today);
  const easyPlayedToday = !!getDailyResult('easy', today);

  const flameH = document.getElementById('flameHard');
  const flameE = document.getElementById('flameEasy');

  flameH.className = 'flame-container ' + (hardPlayedToday ? 'active' : 'inactive');
  flameE.className = 'flame-container ' + (easyPlayedToday ? 'active' : 'inactive');

  document.getElementById('flameHardNum').textContent  = sh.streak || 0;
  document.getElementById('flameEasyNum').textContent  = se.streak || 0;
  document.getElementById('flameHardBest').textContent = `Best: ${sh.best || 0}`;
  document.getElementById('flameEasyBest').textContent = `Best: ${se.best || 0}`;

  const hardStatusEl = document.getElementById('flameHardStatus');
  const easyStatusEl = document.getElementById('flameEasyStatus');

  if (hardPlayedToday) {
    hardStatusEl.textContent = '● Streak active today!';
    hardStatusEl.style.color = 'var(--green)';
  } else {
    hardStatusEl.textContent = '● Play today to keep it alive';
    hardStatusEl.style.color = 'var(--text-dim)';
  }
  if (easyPlayedToday) {
    easyStatusEl.textContent = '● Streak active today!';
    easyStatusEl.style.color = 'var(--green)';
  } else {
    easyStatusEl.textContent = '● Play today to keep it alive';
    easyStatusEl.style.color = 'var(--text-dim)';
  }

  // ── Win / played counts ──
  document.getElementById('statHardWins').textContent   = sh.wins   || 0;
  document.getElementById('statEasyWins').textContent   = se.wins   || 0;
  document.getElementById('statHardPlayed').textContent = sh.played || 0;
  document.getElementById('statEasyPlayed').textContent = se.played || 0;
  document.getElementById('statFreeWins').textContent   = fs.wins   || 0;
  document.getElementById('statFreePlayed').textContent = fs.played || 0;

  // ── Accuracy bars ──
  function pct(wins, played) {
    if (!played) return null;
    return Math.round((wins / played) * 100);
  }
  const hp = pct(sh.wins||0, sh.played||0);
  const ep = pct(se.wins||0, se.played||0);
  const fp = pct(fs.wins||0, fs.played||0);
  const totalWins   = (sh.wins||0) + (se.wins||0) + (fs.wins||0);
  const totalPlayed = (sh.played||0) + (se.played||0) + (fs.played||0);
  const op = pct(totalWins, totalPlayed);

  function setBar(barId, pctId, val) {
    document.getElementById(barId).style.width   = val !== null ? val + '%' : '0%';
    document.getElementById(pctId).textContent   = val !== null ? val + '%' : '—';
  }
  // Delay so animation plays when modal opens
  setTimeout(() => {
    setBar('accHardBar',    'accHardPct',    hp);
