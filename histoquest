<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>HistoQuest – Guess the Historical Figure</title>
  <meta name="description" content="A Wordle-inspired game where you guess famous historical figures." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700;800&family=Cinzel:wght@700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg:#0b0c14; --surface:#13141f; --surface2:#1a1c2e; --border:#2a2d45;
      --accent:#7c6af7; --accent2:#a78bfa;
      --gold:#f0c040;
      --green:#22c55e; --green-bg:#14532d;
      --gray:#6b7280; --gray-bg:#1f2937;
      --daily-h:#e879f9; --daily-h-dim:rgba(232,121,249,0.15); --daily-h-border:rgba(232,121,249,0.35);
      --daily-e:#34d399; --daily-e-dim:rgba(52,211,153,0.12); --daily-e-border:rgba(52,211,153,0.35);
      --text:#e8e9f3; --text-dim:#9094b8;
      --radius:12px; --radius-sm:8px;
    }
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    body{font-family:'Outfit',sans-serif;background:var(--bg);color:var(--text);min-height:100vh;overflow-x:hidden}
    body::before{content:'';position:fixed;inset:0;background:radial-gradient(ellipse 80% 50% at 20% 10%,rgba(124,106,247,.12) 0%,transparent 60%),radial-gradient(ellipse 60% 40% at 80% 80%,rgba(167,139,250,.08) 0%,transparent 60%);pointer-events:none;z-index:0}

    /* ── HEADER ── */
    header{position:relative;z-index:10;padding:16px 20px 12px;border-bottom:1px solid var(--border);background:rgba(11,12,20,.85);backdrop-filter:blur(12px);display:flex;align-items:center;justify-content:space-between;gap:10px}
    .header-left{display:flex;align-items:center;flex:1;justify-content:flex-start}
    .header-title{flex:0 1 auto;text-align:center;white-space:nowrap}
    header h1{font-family:'Cinzel',serif;font-size:clamp(1.3rem,3.5vw,2rem);background:linear-gradient(135deg,#c4b5fd,#f0c040,#a78bfa);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;letter-spacing:2px;cursor:pointer;user-select:none}
    header p{color:var(--text-dim);font-size:.78rem;margin-top:2px}
    .header-btn{background:none;border:1px solid var(--border);color:var(--text-dim);border-radius:var(--radius-sm);padding:7px 12px;font-family:'Outfit',sans-serif;font-size:.78rem;cursor:pointer;transition:all .2s;white-space:nowrap}
    .header-btn:hover{border-color:var(--accent2);color:var(--accent2)}
    .header-right{display:flex;align-items:center;gap:7px;flex:1;justify-content:flex-end}

    /* ── APP ── */
    .app{position:relative;z-index:1;max-width:1140px;margin:0 auto;padding:20px 14px 80px}

    /* ── MODE SCREEN ── */
    #modeScreen{display:flex;flex-direction:column;align-items:center;gap:24px;padding-top:30px}
    .mode-hero{text-align:center}
    .mode-hero h2{font-family:'Cinzel',serif;font-size:clamp(1.1rem,2.8vw,1.7rem);color:var(--accent2);margin-bottom:7px}
    .mode-hero p{color:var(--text-dim);max-width:520px;line-height:1.6;font-size:.88rem}
    .mode-cards{display:grid;grid-template-columns:1fr 1fr;gap:16px;width:100%;max-width:860px}
    .mode-card.custom{grid-column:1/-1}

    .mode-card{background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:26px 24px;text-align:center;cursor:pointer;transition:all .3s;position:relative;overflow:hidden}
    .mode-card::after{content:'';position:absolute;inset:0;background:linear-gradient(135deg,transparent 40%,rgba(255,255,255,.03));pointer-events:none}
    .mode-card:hover{transform:translateY(-5px);border-color:var(--accent);box-shadow:0 14px 44px rgba(124,106,247,.28)}
    .mode-card .icon{font-size:2.4rem;margin-bottom:10px}
    .mode-card h3{font-size:1.1rem;font-weight:700;margin-bottom:6px}
    .mode-card p{color:var(--text-dim);font-size:.8rem;line-height:1.5}
    .tries-badge{display:inline-block;margin-top:12px;padding:3px 11px;border-radius:999px;font-size:.74rem;font-weight:600}
    .mode-card.easy .tries-badge{background:rgba(34,197,94,.15);color:var(--green);border:1px solid rgba(34,197,94,.3)}
    .mode-card.hard{border-color:rgba(240,192,64,.2)}.mode-card.hard .tries-badge{background:rgba(240,192,64,.12);color:var(--gold);border:1px solid rgba(240,192,64,.3)}
    .mode-card.hard:hover{border-color:var(--gold);box-shadow:0 14px 44px rgba(240,192,64,.18)}
    .mode-card.daily-h{border-color:var(--daily-h-border)}.mode-card.daily-h .tries-badge{background:var(--daily-h-dim);color:var(--daily-h);border:1px solid var(--daily-h-border)}
    .mode-card.daily-h:hover{border-color:var(--daily-h);box-shadow:0 14px 44px rgba(232,121,249,.22)}
    .mode-card.daily-e{border-color:var(--daily-e-border)}.mode-card.daily-e .tries-badge{background:var(--daily-e-dim);color:var(--daily-e);border:1px solid var(--daily-e-border)}
    .mode-card.daily-e:hover{border-color:var(--daily-e);box-shadow:0 14px 44px rgba(52,211,153,.22)}
    .daily-played-chip{display:none;margin-top:8px;background:rgba(34,197,94,.1);border:1px solid rgba(34,197,94,.3);color:var(--green);border-radius:999px;font-size:.72rem;font-weight:600;padding:2px 9px}
    .daily-played-chip.show{display:inline-block}

    /* Streak bar */
    .streak-row{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
    .streak-chip{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-sm);padding:9px 18px;text-align:center;min-width:80px}
    .sc-val{font-size:1.5rem;font-weight:800;color:var(--gold)}
    .sc-label{font-size:.68rem;color:var(--text-dim);text-transform:uppercase;letter-spacing:.5px;margin-top:2px}

    /* ── GAME ── */
    #gameScreen{display:none}
    .game-meta{display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;flex-wrap:wrap;gap:10px}
    .mode-badge{padding:5px 13px;border-radius:999px;font-size:.8rem;font-weight:600;border:1px solid}
    .mode-badge.easy{background:rgba(34,197,94,.1);color:var(--green);border-color:rgba(34,197,94,.3)}
    .mode-badge.hard{background:rgba(240,192,64,.1);color:var(--gold);border-color:rgba(240,192,64,.3)}
    .mode-badge.daily-h{background:var(--daily-h-dim);color:var(--daily-h);border-color:var(--daily-h-border)}
    .mode-badge.daily-e{background:var(--daily-e-dim);color:var(--daily-e);border-color:var(--daily-e-border)}
    .tries-counter{font-size:.86rem;color:var(--text-dim)}.tries-counter span{color:var(--text);font-weight:700;font-size:.98rem}

    /* Input */
    .input-section{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:16px 20px;margin-bottom:20px;position:relative}
    .input-section label{display:block;font-size:.78rem;color:var(--text-dim);margin-bottom:8px;font-weight:600;letter-spacing:.5px;text-transform:uppercase}
    .input-row{display:flex;gap:9px}
    #guessInput{flex:1;background:var(--surface2);border:1px solid var(--border);border-radius:var(--radius-sm);color:var(--text);font-family:'Outfit',sans-serif;font-size:.95rem;padding:10px 14px;outline:none;transition:border-color .2s}
    #guessInput:focus{border-color:var(--accent)}
    #guessInput::placeholder{color:var(--text-dim)}
    .guess-btn{background:linear-gradient(135deg,var(--accent),#6d59f5);border:none;border-radius:var(--radius-sm);color:#fff;font-family:'Outfit',sans-serif;font-size:.9rem;font-weight:600;padding:10px 20px;cursor:pointer;transition:all .2s;white-space:nowrap}
    .guess-btn:hover{transform:translateY(-1px);box-shadow:0 5px 18px rgba(124,106,247,.4)}
    .guess-btn:disabled{opacity:.4;cursor:not-allowed;transform:none;box-shadow:none}
    .autocomplete-box{position:absolute;top:calc(100% - 4px);left:0;right:0;background:var(--surface2);border:1px solid var(--accent);border-top:none;border-radius:0 0 var(--radius-sm) var(--radius-sm);z-index:100;max-height:240px;overflow-y:auto;display:none}
    .autocomplete-item{padding:9px 14px;cursor:pointer;font-size:.9rem;transition:background .15s}
    .autocomplete-item:hover,.autocomplete-item.active{background:rgba(124,106,247,.15)}

    /* Grid */
    .columns-header{display:grid;grid-template-columns:var(--gtc, 2.2fr .9fr 1.3fr 1.2fr 1.3fr 1.1fr 1.4fr);gap:5px;margin-bottom:7px;padding:0 3px}
    .col-label{font-size:.66rem;font-weight:700;text-transform:uppercase;letter-spacing:.8px;color:var(--text-dim);text-align:center}
    .col-label:first-child{text-align:left}
    #guessBoard{display:flex;flex-direction:column;gap:7px}
    .guess-row{display:grid;grid-template-columns:var(--gtc, 2.2fr .9fr 1.3fr 1.2fr 1.3fr 1.1fr 1.4fr);gap:5px}
    .cell{border-radius:var(--radius-sm);padding:9px 6px;text-align:center;font-size:.75rem;font-weight:600;display:flex;align-items:center;justify-content:center;min-height:50px;word-break:break-word;line-height:1.3;opacity:0;animation:flipIn .4s ease forwards;animation-delay:calc(var(--i,0)*.08s)}
    .cell:first-child{text-align:left;justify-content:flex-start;font-size:.8rem}
    .cell.correct{background:var(--green-bg);border:1px solid rgba(34,197,94,.4);color:#86efac}
    .cell.wrong{background:var(--gray-bg);border:1px solid rgba(107,114,128,.35);color:#9ca3af}
    @keyframes flipIn{0%{opacity:0;transform:rotateX(-90deg) scale(.9)}60%{transform:rotateX(10deg) scale(1.05)}100%{opacity:1;transform:rotateX(0) scale(1)}}

    /* Result */
    #resultBanner{display:none;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:24px 26px;text-align:center;margin-top:20px;animation:fadeUp .5s ease;scroll-margin-top:80px}
    @keyframes fadeUp{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
    #resultBanner.win{border-color:rgba(34,197,94,.4);background:rgba(20,83,45,.15)}
    #resultBanner.lose{border-color:rgba(239,68,68,.3);background:rgba(127,29,29,.1)}
    .result-emoji{font-size:2.6rem;margin-bottom:9px}
    #resultBanner h2{font-size:1.3rem;margin-bottom:6px}
    #resultBanner>p{color:var(--text-dim);margin-bottom:16px}
    .result-actions{display:flex;gap:9px;justify-content:center;flex-wrap:wrap}
    .btn-secondary{background:var(--surface2);border:1px solid var(--border);color:var(--text);border-radius:var(--radius-sm);padding:8px 18px;font-family:'Outfit',sans-serif;font-size:.86rem;cursor:pointer;transition:all .2s}
    .btn-secondary:hover{border-color:var(--accent);color:var(--accent2)}
    .daily-share{margin:12px 0;background:var(--surface2);border:1px solid var(--border);border-radius:var(--radius-sm);padding:13px 15px}
    .daily-share pre{font-family:monospace;font-size:1rem;line-height:1.5;letter-spacing:1px;white-space:pre-wrap;color:var(--text)}
    .share-copy-btn{margin-top:9px;background:none;border:1px solid var(--border);color:var(--text-dim);border-radius:var(--radius-sm);padding:5px 13px;font-family:'Outfit',sans-serif;font-size:.78rem;cursor:pointer;transition:all .2s}
    .share-copy-btn:hover{border-color:var(--accent2);color:var(--accent2)}

    /* Already played */
    #dailyAlreadyPlayed{display:none;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:28px 24px;text-align:center;margin-top:20px}
    #dailyAlreadyPlayed h2{font-size:1.25rem;margin-bottom:7px}
    #dailyAlreadyPlayed>p{color:var(--text-dim);margin-bottom:14px;font-size:.88rem}
    .countdown-display{font-size:1.9rem;font-weight:800;color:var(--gold);margin:8px 0 16px;letter-spacing:2px;font-variant-numeric:tabular-nums}

    /* ── FIGURES PANEL ── */
    #listPanel{position:fixed;top:0;right:-440px;width:440px;height:100vh;background:var(--surface);border-left:1px solid var(--border);z-index:200;transition:right .35s cubic-bezier(.34,1.56,.64,1);display:flex;flex-direction:column;box-shadow:-20px 0 60px rgba(0,0,0,.5)}
    #listPanel.open{right:0}
    .panel-header{padding:18px 20px 12px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;flex-shrink:0}
    .panel-header h2{font-size:.95rem;font-weight:700}
    .close-panel{background:none;border:none;color:var(--text-dim);font-size:1.3rem;cursor:pointer;line-height:1;transition:color .2s}
    .close-panel:hover{color:var(--text)}
    .panel-toolbar{padding:10px 20px;border-bottom:1px solid var(--border);flex-shrink:0;display:flex;flex-direction:column;gap:8px}
    .panel-toolbar input{width:100%;background:var(--surface2);border:1px solid var(--border);border-radius:var(--radius-sm);color:var(--text);font-family:'Outfit',sans-serif;font-size:.84rem;padding:8px 12px;outline:none}
    .panel-toolbar input:focus{border-color:var(--accent)}
    .filter-toggle{display:flex;align-items:center;gap:8px;cursor:pointer;user-select:none}
    .toggle-track{width:36px;height:20px;background:var(--gray-bg);border:1px solid var(--border);border-radius:999px;position:relative;transition:background .25s,border-color .25s;flex-shrink:0}
    .toggle-track.on{background:rgba(124,106,247,.3);border-color:var(--accent)}
    .toggle-thumb{position:absolute;top:2px;left:2px;width:14px;height:14px;background:var(--text-dim);border-radius:50%;transition:transform .25s,background .25s}
    .toggle-track.on .toggle-thumb{transform:translateX(16px);background:var(--accent2)}
    .filter-toggle span{font-size:.78rem;color:var(--text-dim)}
    .filter-toggle.on span{color:var(--accent2);font-weight:600}
    .panel-count{padding:6px 20px 2px;font-size:.7rem;color:var(--text-dim);flex-shrink:0}
    #listLockMsg{display:none;padding:20px 22px;text-align:center;color:var(--text-dim);font-size:.85rem;line-height:1.6}
    #listLockMsg .lock-icon{font-size:2rem;margin-bottom:8px}
    .panel-body{flex:1;overflow-y:auto;padding:9px 20px 18px}
    .figure-card{background:var(--surface2);border:1px solid var(--border);border-radius:var(--radius-sm);padding:10px 12px;margin-bottom:7px;transition:border-color .2s}
    .figure-card:hover{border-color:var(--accent)}
    .figure-card h3{font-size:.85rem;font-weight:700;margin-bottom:5px;color:var(--accent2);display:flex;align-items:center;gap:6px}
    .custom-badge{font-size:.6rem;background:rgba(240,192,64,.15);border:1px solid rgba(240,192,64,.3);color:var(--gold);border-radius:4px;padding:1px 5px;font-weight:600}
    .figure-tags{display:flex;flex-wrap:wrap;gap:3px}
    .tag{font-size:.63rem;padding:2px 7px;border-radius:999px;background:rgba(124,106,247,.1);border:1px solid rgba(124,106,247,.18);color:var(--text-dim)}

    /* Overlay */
    #overlay{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:199;opacity:0;pointer-events:none;transition:opacity .3s}
    #overlay.active{opacity:1;pointer-events:all}

    /* ── DEV & CUSTOM CONSOLES ── */
    #devModal, #customModal {display:none;position:fixed;inset:0;z-index:500;align-items:center;justify-content:center;background:rgba(0,0,0,.72);backdrop-filter:blur(4px)}
    #devModal.open, #customModal.open {display:flex}
    .dev-box{background:var(--surface);border:1px solid var(--border);border-radius:18px;width:min(620px,96vw);max-height:92vh;display:flex;flex-direction:column;box-shadow:0 24px 80px rgba(0,0,0,.6);animation:fadeUp .3s ease}
    .dev-header{padding:18px 22px 13px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;flex-shrink:0}
    .dev-header h2{font-size:.95rem;font-weight:700;color:var(--gold);display:flex;align-items:center;gap:7px}
    .dev-close{background:none;border:none;color:var(--text-dim);font-size:1.3rem;cursor:pointer;transition:color .2s}
    .dev-close:hover{color:var(--text)}

    /* Dev Tabs */
    .dev-tabs{display:flex;border-bottom:1px solid var(--border);flex-shrink:0;overflow-x:auto}
    .dev-tab{padding:10px 16px;font-size:.78rem;font-weight:600;cursor:pointer;color:var(--text-dim);border-bottom:2px solid transparent;white-space:nowrap;transition:all .2s}
    .dev-tab:hover{color:var(--text)}
    .dev-tab.active{color:var(--gold);border-bottom-color:var(--gold)}
    .dev-tab-content{display:none;flex:1;overflow-y:auto;padding:18px 22px 22px}
    .dev-tab-content.active{display:block}

    /* Dev form elements */
    .dev-section-title{font-size:.74rem;text-transform:uppercase;letter-spacing:.7px;color:var(--text-dim);margin-bottom:10px;font-weight:700}
    .dev-row{display:flex;gap:7px;align-items:center;margin-bottom:7px}
    .dev-input{background:var(--surface2);border:1px solid var(--border);border-radius:var(--radius-sm);color:var(--text);font-family:'Outfit',sans-serif;font-size:.84rem;padding:8px 12px;outline:none;flex:1;transition:border-color .2s}
    .dev-input:focus{border-color:var(--gold)}
    .dev-select{background:var(--surface2);border:1px solid var(--border);border-radius:var(--radius-sm);color:var(--text);font-family:'Outfit',sans-serif;font-size:.84rem;padding:8px 12px;outline:none;cursor:pointer;transition:border-color .2s}
    .dev-select:focus{border-color:var(--gold)}
    .dev-btn{background:rgba(240,192,64,.12);border:1px solid rgba(240,192,64,.3);color:var(--gold);border-radius:var(--radius-sm);padding:8px 14px;font-family:'Outfit',sans-serif;font-size:.8rem;font-weight:600;cursor:pointer;transition:all .2s;white-space:nowrap}
    .dev-btn:hover{background:rgba(240,192,64,.22)}
    .dev-btn.purple{background:rgba(124,106,247,.15);border-color:rgba(124,106,247,.3);color:var(--accent2)}
    .dev-btn.purple:hover{background:rgba(124,106,247,.25)}
    .dev-btn.danger{background:rgba(239,68,68,.1);border-color:rgba(239,68,68,.3);color:#f87171}
    .dev-btn.danger:hover{background:rgba(239,68,68,.2)}
    .dev-btn.green{background:rgba(34,197,94,.12);border-color:rgba(34,197,94,.3);color:var(--green)}
    .dev-btn.green:hover{background:rgba(34,197,94,.22)}
    .dev-separator{border:none;border-top:1px solid var(--border);margin:14px 0}
    .dev-info{font-size:.78rem;color:var(--text-dim);line-height:1.55}
    .dev-info strong{color:var(--text)}
    .dev-form-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:8px}
    .dev-field label{font-size:.72rem;color:var(--text-dim);display:block;margin-bottom:4px;font-weight:600;text-transform:uppercase;letter-spacing:.4px}
    .dev-field input,.dev-field select{width:100%;background:var(--surface2);border:1px solid var(--border);border-radius:var(--radius-sm);color:var(--text);font-family:'Outfit',sans-serif;font-size:.84rem;padding:8px 11px;outline:none;transition:border-color .2s}
    .dev-field input:focus,.dev-field select:focus{border-color:var(--gold)}

    /* Schedule list */
    .dev-schedule-list{display:flex;flex-direction:column;gap:5px;max-height:180px;overflow-y:auto}
    .dev-schedule-item{display:flex;align-items:center;background:var(--surface2);border:1px solid var(--border);border-radius:var(--radius-sm);padding:7px 11px;gap:7px}
    .ds-date{font-size:.74rem;color:var(--text-dim);min-width:88px}
    .ds-name{font-size:.84rem;font-weight:600;color:var(--accent2);flex:1}
    .ds-today{font-size:.66rem;color:var(--green);font-weight:600}
    .dev-del-btn{background:none;border:none;color:var(--text-dim);cursor:pointer;font-size:.95rem;transition:color .2s;padding:1px 3px}
    .dev-del-btn:hover{color:#f87171}

    /* Manage figures list */
    .dev-fig-list{display:flex;flex-direction:column;gap:5px;max-height:300px;overflow-y:auto;margin-top:8px}
    .dev-fig-item{display:flex;align-items:center;background:var(--surface2);border:1px solid var(--border);border-radius:var(--radius-sm);padding:8px 11px;gap:8px}
    .dev-fig-name{font-size:.84rem;font-weight:600;color:var(--text);flex:1}
    .dev-fig-meta{font-size:.7rem;color:var(--text-dim)}

    /* Auth */
    #devAuth{padding:28px 24px;display:flex;flex-direction:column;gap:13px;align-items:center;text-align:center}
    #devAuth h3{font-size:.98rem;font-weight:700;color:var(--gold)}
    #devAuth p{font-size:.8rem;color:var(--text-dim)}
    #devAuthInput{width:100%;max-width:260px;text-align:center;letter-spacing:2px}
    #devAuthError{font-size:.75rem;color:#f87171;display:none}

    /* Scrollbar */
    ::-webkit-scrollbar{width:5px}::-webkit-scrollbar-track{background:transparent}::-webkit-scrollbar-thumb{background:var(--border);border-radius:3px}

    /* Toast */
    #toast{position:fixed;bottom:26px;left:50%;transform:translateX(-50%) translateY(80px);background:var(--surface2);border:1px solid var(--border);color:var(--text);padding:10px 20px;border-radius:999px;font-size:.86rem;z-index:400;transition:transform .3s cubic-bezier(.34,1.56,.64,1),opacity .3s;opacity:0;pointer-events:none}
    #toast.show{transform:translateX(-50%) translateY(0);opacity:1}

    /* ── STATS MODAL ── */
    #statsModal{display:none;position:fixed;inset:0;z-index:500;align-items:center;justify-content:center;background:rgba(0,0,0,.75);backdrop-filter:blur(6px)}
    #statsModal.open{display:flex}
    .stats-box{background:var(--surface);border:1px solid var(--border);border-radius:20px;width:min(680px,96vw);max-height:92vh;overflow-y:auto;display:flex;flex-direction:column;box-shadow:0 28px 90px rgba(0,0,0,.7);animation:fadeUp .35s ease}
    .stats-header{padding:20px 26px 14px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;flex-shrink:0}
    .stats-header h2{font-family:'Cinzel',serif;font-size:1.15rem;font-weight:700;background:linear-gradient(135deg,#f0c040,#f97316,#a78bfa);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;letter-spacing:1px}
    .stats-close{background:none;border:none;color:var(--text-dim);font-size:1.3rem;cursor:pointer;transition:color .2s;padding:4px}
    .stats-close:hover{color:var(--text)}
    .stats-body{padding:26px 28px 30px;display:flex;flex-direction:column;gap:32px}

    /* ── FLAME STREAK ── */
    .flame-section{display:flex;gap:24px;justify-content:center;flex-wrap:wrap}
    .flame-wrap{display:flex;flex-direction:column;align-items:center;gap:10px}
    .flame-label{font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--text-dim)}
    .flame-container{position:relative;width:110px;height:130px;display:flex;align-items:center;justify-content:center}

    /* Flame layers */
    .flame-container .flame-layer{
      position:absolute;bottom:0;left:50%;transform:translateX(-50%);
      border-radius:50% 50% 50% 50% / 60% 60% 40% 40%;
      filter:blur(1px);
      animation:flicker 1.8s ease-in-out infinite alternate;
    }
    .flame-container.active .flame-layer:nth-child(1){
      width:76px;height:100px;background:radial-gradient(ellipse at 50% 80%,#ff6a00,#ee0979 60%,transparent 100%);
      animation-delay:0s;animation-duration:1.6s;
    }
    .flame-container.active .flame-layer:nth-child(2){
      width:56px;height:78px;background:radial-gradient(ellipse at 50% 80%,#ffd200,#ff6a00 60%,transparent 100%);
      animation-delay:.2s;animation-duration:1.3s;
    }
    .flame-container.active .flame-layer:nth-child(3){
      width:36px;height:54px;background:radial-gradient(ellipse at 50% 80%,#fff7aa,#ffd200 50%,transparent 100%);
      animation-delay:.35s;animation-duration:1.1s;
      filter:blur(0.5px);
    }
    /* Inactive (dim) flame */
    .flame-container.inactive .flame-layer:nth-child(1){
      width:76px;height:100px;background:radial-gradient(ellipse at 50% 80%,#4a1a2e,#2d0a3a 60%,transparent 100%);
      animation-delay:0s;animation-duration:2.4s;
      opacity:.7;
    }
    .flame-container.inactive .flame-layer:nth-child(2){
      width:56px;height:78px;background:radial-gradient(ellipse at 50% 80%,#2a1540,#4a1a2e 60%,transparent 100%);
      animation-delay:.3s;animation-duration:2s;
      opacity:.6;
    }
    .flame-container.inactive .flame-layer:nth-child(3){
      width:36px;height:54px;background:radial-gradient(ellipse at 50% 80%,#3d2060,#2a1540 50%,transparent 100%);
      animation-delay:.5s;animation-duration:1.8s;
      opacity:.5;
    }
    @keyframes flicker{
      0%{transform:translateX(-50%) scaleX(1) scaleY(1) rotate(-1deg)}
      25%{transform:translateX(-50%) scaleX(1.04) scaleY(1.03) rotate(1.5deg)}
      50%{transform:translateX(-50%) scaleX(0.97) scaleY(1.05) rotate(-0.5deg)}
      75%{transform:translateX(-50%) scaleX(1.03) scaleY(0.98) rotate(1deg)}
      100%{transform:translateX(-50%) scaleX(0.99) scaleY(1.04) rotate(-1.5deg)}
    }
    .flame-number{
      position:absolute;z-index:2;font-size:2.8rem;font-weight:800;
      font-family:'Outfit',sans-serif;
      text-shadow:0 0 18px rgba(0,0,0,.8),0 2px 6px rgba(0,0,0,.9);
      letter-spacing:-1px;line-height:1;
      bottom:18px;
    }
    .flame-container.active .flame-number{color:#fff7e6;text-shadow:0 0 20px #ff6a00,0 0 40px #ffd200,0 2px 6px rgba(0,0,0,.8)}
    .flame-container.inactive .flame-number{color:#a78bfa;text-shadow:0 0 14px rgba(124,106,247,.5),0 2px 4px rgba(0,0,0,.8)}
    .flame-sub{font-size:.68rem;color:var(--text-dim);font-weight:600;margin-top:-4px}
    .flame-best{font-size:.72rem;font-weight:700;color:var(--gold);margin-top:2px;letter-spacing:.3px}
    .flame-status-dot{
      width:8px;height:8px;border-radius:50%;display:inline-block;margin-right:4px;
      vertical-align:middle;
    }
    .flame-container.active ~ .flame-status{color:var(--green)}
    .flame-status{font-size:.67rem;font-weight:600;letter-spacing:.3px;margin-top:1px}
    .flame-container.inactive ~ .flame-status{color:var(--text-dim)}

    /* ── STATS GRID ── */
    .stats-section-title{font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.8px;color:var(--text-dim);margin-bottom:12px}
    .stats-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px}
    .stat-tile{background:var(--surface2);border:1px solid var(--border);border-radius:12px;padding:14px 16px;text-align:center}
    .stat-tile-val{font-size:2rem;font-weight:800;color:var(--accent2);line-height:1;margin-bottom:4px}
    .stat-tile-val.gold{color:var(--gold)}
    .stat-tile-val.green{color:var(--green)}
    .stat-tile-label{font-size:.68rem;color:var(--text-dim);font-weight:600;text-transform:uppercase;letter-spacing:.4px}

    /* Accuracy bar */
    .acc-bar-wrap{margin-top:8px}
    .acc-bar-row{display:flex;align-items:center;gap:10px;margin-bottom:7px}
    .acc-bar-label{font-size:.75rem;color:var(--text-dim);font-weight:600;min-width:90px}
    .acc-bar-track{flex:1;height:8px;background:var(--surface2);border-radius:999px;overflow:hidden;border:1px solid var(--border)}
    .acc-bar-fill{height:100%;border-radius:999px;transition:width 1s cubic-bezier(.34,1.56,.64,1);min-width:4px}
    .acc-bar-fill.hard{background:linear-gradient(90deg,#f0c040,#f97316)}
    .acc-bar-fill.easy{background:linear-gradient(90deg,#22c55e,#34d399)}
    .acc-bar-fill.overall{background:linear-gradient(90deg,#7c6af7,#a78bfa)}
    .acc-pct{font-size:.78rem;font-weight:700;min-width:38px;text-align:right;color:var(--text)}

    /* Share opts */
    .stats-footer{padding:0 28px 24px;border-top:1px solid var(--border);margin-top:0}
    .share-main-btn{width:100%;margin-top:18px;background:linear-gradient(135deg,var(--accent),#6d59f5);border:none;border-radius:var(--radius-sm);color:#fff;font-family:'Outfit',sans-serif;font-size:.92rem;font-weight:700;padding:12px 0;cursor:pointer;transition:all .2s;display:flex;align-items:center;justify-content:center;gap:8px;letter-spacing:.3px}
    .share-main-btn:hover{transform:translateY(-2px);box-shadow:0 6px 22px rgba(124,106,247,.45)}
    .share-opts-panel{display:none;flex-direction:column;gap:7px;margin-top:10px;animation:fadeUp .2s ease}
    .share-opts-panel.show{display:flex}
    .share-opt-btn{background:var(--surface2);border:1px solid var(--border);color:var(--text);border-radius:var(--radius-sm);padding:12px 16px;font-family:'Outfit',sans-serif;font-size:.86rem;cursor:pointer;transition:all .2s;display:flex;align-items:center;gap:12px;text-align:left}
    .share-opt-btn:hover{border-color:var(--accent);color:var(--accent2);background:rgba(124,106,247,.08)}
    .share-opt-icon{font-size:1.3rem;flex-shrink:0}
    .share-opt-title{font-weight:700;font-size:.86rem}
    .share-opt-desc{font-size:.7rem;color:var(--text-dim);margin-top:2px}

    @media(max-width:720px){
      .mode-cards{grid-template-columns:1fr}
      .columns-header,.guess-row{grid-template-columns:var(--gtc-sm, 1.8fr .8fr 1.1fr 1fr 1.1fr .9fr 1.2fr);gap:4px}
      .cell{font-size:.64rem;padding:7px 4px;min-height:46px}
      .col-label{font-size:.56rem}
      #listPanel{width:100%;right:-100%}
      .dev-form-grid{grid-template-columns:1fr}
      .flame-container{width:90px;height:110px}
      .flame-number{font-size:2.2rem}
      .stats-box{border-radius:14px}
    }
  </style>
</head>
<body>
<div id="overlay" onclick="closePanel(); closeCustomModal()"></div>
<div id="toast"></div>

<!-- ── DEV CONSOLE ── -->
<div id="devModal">
  <div class="dev-box">
    <!-- Auth gate -->
    <div id="devAuth">
      <h3>🔐 Developer Console</h3>
      <p>Enter the developer password to continue.</p>
      <input class="dev-input" id="devAuthInput" type="password" placeholder="Password…" style="max-width:260px;text-align:center;letter-spacing:2px" onkeydown="if(event.key==='Enter')devLogin()" />
      <div id="devAuthError">❌ Incorrect password</div>
      <button class="dev-btn" onclick="devLogin()">Unlock →</button>
    </div>

    <!-- Console -->
    <div id="devConsole" style="display:none;flex-direction:column;flex:1;overflow:hidden">
      <div class="dev-header">
        <h2>⚙️ Developer Console</h2>
        <button class="dev-close" onclick="closeDevModal()">✕</button>
      </div>
      <!-- Tabs -->
      <div class="dev-tabs">
        <div class="dev-tab active" onclick="devTab('hard-daily')"   id="tab-hard-daily">📅 Hard Daily</div>
        <div class="dev-tab"        onclick="devTab('easy-daily')"   id="tab-easy-daily">🌿 Easy Daily</div>
        <div class="dev-tab"        onclick="devTab('add-figure')"   id="tab-add-figure">➕ Add Figure</div>
        <div class="dev-tab"        onclick="devTab('edit-figure')"  id="tab-edit-figure">✏️ Edit Figure</div>
        <div class="dev-tab"        onclick="devTab('manage')"       id="tab-manage">🗂 Manage</div>
        <div class="dev-tab"        onclick="devTab('tools')"        id="tab-tools">🛠 Tools</div>
      </div>

      <!-- TAB: Hard Daily -->
      <div class="dev-tab-content active" id="tc-hard-daily">
        <div class="dev-section-title">📌 Today's Hard Daily</div>
        <p class="dev-info" id="devHardTodayInfo">—</p>
        <hr class="dev-separator">
        <div class="dev-section-title">Schedule Hard Daily Answer</div>
        <div class="dev-row">
          <input class="dev-input" id="hdDate" type="date" />
          <button class="dev-btn purple" onclick="devHardPickRandom()">🎲 Random</button>
        </div>
        <div class="dev-row">
          <input class="dev-input" id="hdFigure" placeholder="Figure name…" list="hdFigureList" />
          <button class="dev-btn" onclick="devAddHardSchedule()">+ Schedule</button>
        </div>
        <datalist id="hdFigureList"></datalist>
        <hr class="dev-separator">
        <div class="dev-section-title">Upcoming Hard Daily Schedule</div>
        <div class="dev-schedule-list" id="hdScheduleList"></div>
      </div>

      <!-- TAB: Easy Daily -->
      <div class="dev-tab-content" id="tc-easy-daily">
        <div class="dev-section-title">📌 Today's Easy Daily</div>
        <p class="dev-info" id="devEasyTodayInfo">—</p>
        <hr class="dev-separator">
        <div class="dev-section-title">Schedule Easy Daily Answer</div>
        <div class="dev-row">
          <input class="dev-input" id="edDate" type="date" />
          <button class="dev-btn purple" onclick="devEasyPickRandom()">🎲 Random</button>
        </div>
        <div class="dev-row">
          <input class="dev-input" id="edFigure" placeholder="Figure name…" list="edFigureList" />
          <button class="dev-btn green" onclick="devAddEasySchedule()">+ Schedule</button>
        </div>
        <datalist id="edFigureList"></datalist>
        <hr class="dev-separator">
        <div class="dev-section-title">Upcoming Easy Daily Schedule</div>
        <div class="dev-schedule-list" id="edScheduleList"></div>
      </div>

      <!-- TAB: Add Figure -->
      <div class="dev-tab-content" id="tc-add-figure">
        <div class="dev-section-title">Add New Historical Figure to Database</div>
        <div class="dev-form-grid">
          <div class="dev-field" style="grid-column:1/-1">
            <label>Full Name *</label>
            <input id="nf-name" placeholder="e.g. Cleopatra VII" />
          </div>
          <div class="dev-field">
            <label>Gender *</label>
            <select id="nf-gender">
              <option value="Male">Male</option>
              <option value="Female">Female</option>
              <option value="Unknown">Unknown</option>
            </select>
          </div>
          <div class="dev-field">
            <label>Occupation *</label>
            <select id="nf-occupation">
              <option value="General">General</option>
              <option value="Politician">Politician</option>
              <option value="Scientist">Scientist</option>
              <option value="Philosopher">Philosopher</option>
              <option value="Explorer">Explorer</option>
              <option value="Inventor">Inventor</option>
              <option value="Religious Figure">Religious Figure</option>
              <option value="Artist">Artist</option>
              <option value="Revolutionary">Revolutionary</option>
              <option value="Leader">Leader</option>
              <option value="Writer">Writer</option>
              <option value="Mathematician">Mathematician</option>
            </select>
          </div>
          <div class="dev-field">
            <label>Country / Civilization *</label>
            <input id="nf-country" placeholder="e.g. Egypt, Ottoman Empire" />
          </div>
          <div class="dev-field">
            <label>Century *</label>
            <input id="nf-century" placeholder="e.g. 1st BC, 19th, 20th–21st" />
          </div>
          <div class="dev-field">
            <label>Continent *</label>
            <select id="nf-continent">
              <option value="Europe">Europe</option>
              <option value="Asia">Asia</option>
              <option value="Africa">Africa</option>
              <option value="North America">North America</option>
              <option value="South America">South America</option>
              <option value="Oceania">Oceania</option>
            </select>
          </div>
          <div class="dev-field">
            <label>Religion *</label>
            <input id="nf-religion" placeholder="e.g. Catholic, Muslim, Pagan…" />
          </div>
        </div>
        <div class="dev-row" style="margin-top:4px">
          <button class="dev-btn green" style="flex:1" onclick="devAddFigure()">✅ Add Figure to Database</button>
          <button class="dev-btn" onclick="devClearNewFigureForm()">Clear</button>
        </div>
        <p class="dev-info" style="margin-top:10px">Custom figures are saved in your browser and appear in all game modes and the figures list panel. They are marked with a <strong style="color:var(--gold)">CUSTOM</strong> badge.</p>
      </div>

      <!-- TAB: Edit Figure -->
      <div class="dev-tab-content" id="tc-edit-figure">
        <div class="dev-section-title">Edit Existing Figure</div>
        <div class="dev-row">
          <input class="dev-input" id="ef-select" placeholder="Type a figure name to load..." list="efFigureList" onchange="devLoadFigureToEdit()" />
        </div>
        <datalist id="efFigureList"></datalist>

        <div class="dev-form-grid" id="ef-form-grid" style="display:none; margin-top:10px">
          <div class="dev-field" style="grid-column:1/-1">
            <label>Full Name (Read-only)</label>
            <input id="ef-name" readonly style="opacity:0.7" />
          </div>
          <div class="dev-field">
            <label>Gender *</label>
            <select id="ef-gender">
              <option value="Male">Male</option>
              <option value="Female">Female</option>
              <option value="Unknown">Unknown</option>
            </select>
          </div>
          <div class="dev-field">
            <label>Occupation *</label>
            <select id="ef-occupation">
              <option value="General">General</option>
              <option value="Politician">Politician</option>
              <option value="Scientist">Scientist</option>
              <option value="Philosopher">Philosopher</option>
              <option value="Explorer">Explorer</option>
              <option value="Inventor">Inventor</option>
              <option value="Religious Figure">Religious Figure</option>
              <option value="Artist">Artist</option>
              <option value="Revolutionary">Revolutionary</option>
              <option value="Leader">Leader</option>
              <option value="Writer">Writer</option>
              <option value="Mathematician">Mathematician</option>
            </select>
          </div>
          <div class="dev-field">
            <label>Country / Civilization *</label>
            <input id="ef-country" />
          </div>
          <div class="dev-field">
            <label>Century *</label>
            <input id="ef-century" />
          </div>
          <div class="dev-field">
            <label>Continent *</label>
            <select id="ef-continent">
              <option value="Europe">Europe</option>
              <option value="Asia">Asia</option>
              <option value="Africa">Africa</option>
              <option value="North America">North America</option>
              <option value="South America">South America</option>
              <option value="Oceania">Oceania</option>
            </select>
          </div>
          <div class="dev-field">
            <label>Religion *</label>
            <input id="ef-religion" />
          </div>
        </div>
        <div class="dev-row" id="ef-actions" style="display:none; margin-top:4px">
          <button class="dev-btn green" style="flex:1" onclick="devSaveFigureEdit()">✅ Save Changes</button>
          <button class="dev-btn" onclick="devResetEditForm()">Cancel</button>
        </div>
        <p class="dev-info" style="margin-top:10px">Changes to built-in figures are saved to your browser. Use the <strong>Export Patched DB</strong> tool to generate source code for the main file.</p>
      </div>

      <!-- TAB: Manage Figures -->
      <div class="dev-tab-content" id="tc-manage">
        <div class="dev-section-title">Database Summary</div>
        <p class="dev-info" id="devManageSummary">—</p>
        <hr class="dev-separator">
        <div class="dev-section-title">Custom Figures <span id="customFigureCount" style="color:var(--gold)">(0)</span></div>
        <p class="dev-info" style="margin-bottom:8px">Built-in figures cannot be removed. Custom figures can be deleted below.</p>
        <div class="dev-fig-list" id="devCustomFigList"></div>
        <p class="dev-info" style="margin-top:10px" id="noCustomMsg">No custom figures added yet. Use the <strong>Add Figure</strong> tab.</p>
      </div>

      <!-- TAB: Tools -->
      <div class="dev-tab-content" id="tc-tools">
        <div class="dev-section-title">Export Game for Web</div>
        <p class="dev-info" style="margin-bottom:8px">Downloads a complete <strong>histordle.html</strong> file with all your custom figures, presets, edits, and schedules hardcoded into the source. Upload this file to your web host so everyone sees your changes!</p>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
          <button class="dev-btn purple" onclick="devExportFullGame()">💾 Export Full Game File</button>
        </div>
        <hr class="dev-separator">
        <div class="dev-section-title">Reset Daily Plays</div>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
          <button class="dev-btn" onclick="devResetToday('hard')">Reset Hard Daily</button>
          <button class="dev-btn green" onclick="devResetToday('easy')">Reset Easy Daily</button>
        </div>
        <hr class="dev-separator">
        <div class="dev-section-title">Danger Zone</div>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
          <button class="dev-btn danger" onclick="devClearCustomFigures()">Delete All Custom Figures</button>
          <button class="dev-btn danger" onclick="devClearAll()">Wipe All Data</button>
        </div>
        <hr class="dev-separator">
        <p class="dev-info">
          <strong>Access method:</strong> Click HISTORDLE title 7 times rapidly.<br>
          <strong>Password:</strong> set in source code only.<br>
          All data is stored in your browser's <strong>localStorage</strong>.
        </p>
      </div>
    </div>
  </div>
</div>

<!-- ── CUSTOM MODAL ── -->
<div id="customModal">
  <div class="dev-box" style="max-width:700px">
    <div class="dev-header">
      <h2>✨ Custom Game Mode</h2>
      <button class="dev-close" onclick="closeCustomModal()">✕</button>
    </div>
    
    <!-- PRESET LIST -->
    <div id="cm-list-view" style="display:flex;flex-direction:column;flex:1;overflow-y:auto;padding:20px">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px">
        <div class="dev-section-title" style="margin:0">Saved Presets</div>
        <button class="dev-btn purple" onclick="openPresetBuilder()">+ Create New Preset</button>
      </div>
      <div id="cm-preset-list" class="dev-fig-list" style="max-height:none"></div>
      <p id="cm-no-presets" class="dev-info" style="text-align:center;margin-top:20px;display:none">No presets found. Create one to play Custom Mode!</p>
    </div>

    <!-- PRESET BUILDER -->
    <div id="cm-builder-view" style="display:none;flex-direction:column;flex:1;overflow-y:auto;padding:20px">
      <div class="dev-section-title">1. Preset Settings</div>
      <div class="dev-field" style="margin-bottom:12px">
        <label>Preset Name *</label>
        <input id="cb-name" placeholder="e.g. My Anime Characters..." />
      </div>
      
      <div class="dev-section-title">2. Custom Categories</div>
      <p class="dev-info" style="margin-bottom:8px">Define the columns/clues for your game (e.g. Element, Weapon, Rarity). 'Name' is included automatically.</p>
      <div id="cb-categories" style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:8px"></div>
      <button class="dev-btn" onclick="cbAddCategory()" style="align-self:flex-start">+ Add Category</button>
      
      <hr class="dev-separator">
      
      <div class="dev-section-title">3. Add Figures</div>
      <p class="dev-info" style="margin-bottom:8px">Add at least 3 figures to make it a game.</p>
      
      <div class="dev-form-grid" id="cb-figure-form"></div>
      <button class="dev-btn green" onclick="cbAddFigure()" style="margin-top:8px;width:100%">✅ Add Figure to Preset</button>
      
      <div class="dev-section-title" style="margin-top:16px">Figures in this Preset (<span id="cb-fig-count">0</span>)</div>
      <div id="cb-fig-list" class="dev-fig-list" style="margin-bottom:16px;max-height:160px"></div>
      
      <hr class="dev-separator">
      <div style="display:flex;gap:10px">
        <button class="dev-btn purple" style="flex:1;font-size:.9rem;padding:12px" onclick="cbSavePreset()">💾 Save Preset</button>
        <button class="dev-btn" style="padding:12px" onclick="closePresetBuilder()">Cancel</button>
      </div>
    </div>
  </div>
</div>

<!-- ── FIGURES PANEL ── -->
<div id="listPanel">
  <div class="panel-header">
    <h2>📜 Historical Figures</h2>
    <button class="close-panel" onclick="closePanel()">✕</button>
  </div>
  <div class="panel-toolbar" id="panelToolbar">
    <input type="text" id="panelSearch" placeholder="Search figures…" oninput="renderPanel()" />
    <label class="filter-toggle" id="filterToggle" onclick="toggleSmartFilter()">
