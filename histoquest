  else                 { badge.textContent = '🌿 Daily Easy'; badge.className = 'mode-badge daily-e'; }

  const showList = (type === 'easy');
  document.getElementById('listBtn').style.display      = showList ? '' : 'none';
  document.getElementById('panelToolbar').style.display = showList ? '' : 'none';
  document.getElementById('listLockMsg').style.display  = showList ? 'none' : 'block';
  document.getElementById('panelBody').style.display    = showList ? '' : 'none';
  document.getElementById('panelCount').style.display   = showList ? '' : 'none';

  if (played) {
    // Already played — show summary
    document.getElementById('inputSection').style.display      = 'none';
    document.getElementById('guessBoard').innerHTML            = '';
    document.getElementById('colHeader').style.display         = 'none';
    document.getElementById('resultBanner').style.display      = 'none';
    document.getElementById('dailyAlreadyPlayed').style.display = 'block';

    const fig = getDailyFigure(type, today);
    document.getElementById('dapTitle').textContent = type === 'hard' ? '📅 Already played Hard Daily!' : '🌿 Already played Easy Daily!';
    document.getElementById('dapMsg').textContent   = played.won
      ? `You guessed ${fig.name} in ${played.guesses.length}/${type==='hard'?7:10} tries! 🏆`
      : `The answer was: ${fig.name}. Better luck tomorrow!`;

    const shareText = buildShareText(type, today, played.guesses, played.won, type==='hard'?7:10);
    document.getElementById('dapShareText').textContent = shareText;
    document.getElementById('dapShareBox').style.display = 'block';

    document.getElementById('triesLeft').textContent       = Math.max(0, (type==='hard'?7:10) - played.guesses.length);
    document.getElementById('triesUsedDisplay').textContent = `${played.guesses.length} / ${type==='hard'?7:10} used`;

    replayBoard(played.guesses, getDailyFigure(type, today), true);
    startCountdown();
    return;
  }

  // Fresh game
  currentMode  = `daily-${type}`;
  maxTries     = type === 'hard' ? 7 : 10;
  target       = getDailyFigure(type, today);
  guesses      = [];
  knownCorrect = {};
