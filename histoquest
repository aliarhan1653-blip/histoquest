function todayStr() {
  const d = new Date();
  return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
}
function getSchedule(type) {
  let local = {};
  try { local = JSON.parse(localStorage.getItem(`histordle_sched_${type}`) || '{}'); } catch {}
  const hc = type === 'hard' ? HC_SCHED_HARD : HC_SCHED_EASY;
  return { ...hc, ...local };
}
function saveSchedule(type, s) { localStorage.setItem(`histordle_sched_${type}`, JSON.stringify(s)); }

function getDailyFigure(type, dateStr) {
  const sched = getSchedule(type);
  if (sched[dateStr]) {
    const f = getAllFigures().find(fig => fig.name === sched[dateStr]);
    if (f) return f;
  }
  if (type === 'hard') {
    // Deterministic from hard pool + custom figures
    const pool = [...HARD_DAILY_POOL, ...getCustomFigures().map(f => f.name)];
    let hash = 0;
    for (let i = 0; i < dateStr.length; i++) hash = (hash * 31 + dateStr.charCodeAt(i)) & 0xffffffff;
    const name = pool[Math.abs(hash) % pool.length];
    return getAllFigures().find(f => f.name === name) || BUILTIN_FIGURES[0];
  } else {
    // Easy: full database, deterministic
    const all = getAllFigures();
    let hash = 7;
    for (let i = 0; i < dateStr.length; i++) hash = (hash * 37 + dateStr.charCodeAt(i)) & 0xffffffff;
    return all[Math.abs(hash) % all.length];
  }
}

function getDailyResult(type, dateStr) {
  try { return JSON.parse(localStorage.getItem(`histordle_daily_${type}_${dateStr}`)); } catch { return null; }
}
function saveDailyResult(type, dateStr, data) {
  localStorage.setItem(`histordle_daily_${type}_${dateStr}`, JSON.stringify(data));
}

function getStats(type) {
  try { return JSON.parse(localStorage.getItem(`histordle_stats_${type}`) || '{"streak":0,"best":0,"wins":0,"played":0}'); }
  catch { return {streak:0,best:0,wins:0,played:0}; }
}
function saveStats(type, s) { localStorage.setItem(`histordle_stats_${type}`, JSON.stringify(s)); }

function getFreeStats() {
  try { return JSON.parse(localStorage.getItem('histordle_stats_free') || '{"wins":0,"played":0}'); }
  catch { return {wins:0,played:0}; }
}
function saveFreeStats(s) { localStorage.setItem('histordle_stats_free', JSON.stringify(s)); }

function updateStreak(type, won) {
  const stats = getStats(type);
  if (won) {
    stats.streak++;
    stats.best = Math.max(stats.best, stats.streak);
    stats.wins = (stats.wins||0) + 1;
  } else {
    stats.streak = 0;
  }
  stats.played = (stats.played||0) + 1;
  saveStats(type, stats);
}

function buildShareText(type, dateStr, guessNames, won, maxT) {
  const fig = getDailyFigure(type, dateStr);
  const label = type === 'hard' ? '📅 Daily Hard' : '🌿 Daily Easy';
  const header = `HistoQuest ${label} – ${dateStr}`;
  const result = won ? `✅ ${guessNames.length}/${maxT}` : `❌ X/${maxT}`;
  const rows = guessNames.map(name => {
    const g = getAllFigures().find(f => f.name === name);
    if (!g) return '???????';
    return [g.name===fig.name, g.gender===fig.gender, g.country===fig.country,
            g.century===fig.century, g.occupation===fig.occupation,
            g.continent===fig.continent, g.religion===fig.religion]
      .map(c => c ? '🟩' : '⬜').join('');
  });
  return `${header}\n${result}\n\n${rows.join('\n')}`;
}

