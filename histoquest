// ── Helper: round-rect path ──
function canvasRoundRect(ctx, x, y, w, h, r) {
  ctx.beginPath();
  ctx.moveTo(x+r, y);
  ctx.lineTo(x+w-r, y); ctx.quadraticCurveTo(x+w, y, x+w, y+r);
  ctx.lineTo(x+w, y+h-r); ctx.quadraticCurveTo(x+w, y+h, x+w-r, y+h);
  ctx.lineTo(x+r, y+h); ctx.quadraticCurveTo(x, y+h, x, y+h-r);
  ctx.lineTo(x, y+r); ctx.quadraticCurveTo(x, y, x+r, y);
  ctx.closePath();
}

// ── Download stats image (pure Canvas, no libraries) ──
function downloadStatsImage() {
  const today = todayStr();
  const sh = getStats('hard'), se = getStats('easy'), fs = getFreeStats();
  const hardToday = !!getDailyResult('hard', today);
  const easyToday = !!getDailyResult('easy', today);

  const W = 580, H = 520;
  const canvas = document.createElement('canvas');
  canvas.width = W * 2; canvas.height = H * 2; // hi-DPI
  const ctx = canvas.getContext('2d');
  ctx.scale(2, 2);

  // Background
  ctx.fillStyle = '#0b0c14';
  ctx.fillRect(0, 0, W, H);

  // Radial glow
  const glow = ctx.createRadialGradient(W*.22, H*.12, 0, W*.22, H*.12, W*.65);
  glow.addColorStop(0, 'rgba(124,106,247,.18)'); glow.addColorStop(1, 'transparent');
  ctx.fillStyle = glow; ctx.fillRect(0, 0, W, H);
  const glow2 = ctx.createRadialGradient(W*.8, H*.85, 0, W*.8, H*.85, W*.55);
  glow2.addColorStop(0, 'rgba(167,139,250,.1)'); glow2.addColorStop(1, 'transparent');
  ctx.fillStyle = glow2; ctx.fillRect(0, 0, W, H);

  // Border card
  ctx.strokeStyle = '#2a2d45'; ctx.lineWidth = 1.5;
  canvasRoundRect(ctx, 8, 8, W-16, H-16, 18); ctx.stroke();

  // ── Title ──
  ctx.textAlign = 'center';
  ctx.fillStyle = '#c4b5fd';
  ctx.font = 'bold 26px serif';
  ctx.fillText('HISTOQUEST', W/2, 50);
  ctx.font = '12px sans-serif'; ctx.fillStyle = '#9094b8';
  ctx.fillText('My Statistics  ·  ' + today, W/2, 68);

  // Divider
  ctx.strokeStyle = '#2a2d45'; ctx.lineWidth = 1;
  ctx.beginPath(); ctx.moveTo(36, 80); ctx.lineTo(W-36, 80); ctx.stroke();

  // ── Streak section label ──
  ctx.font = 'bold 10px sans-serif'; ctx.fillStyle = '#9094b8';
  ctx.fillText('🔥  CURRENT STREAKS', W/2, 100);

  // Draw flame cards
  function drawFlameBlock(cx, cy, streak, best, label, active) {
    const bg   = active ? 'rgba(255,106,0,0.12)' : 'rgba(42,21,64,0.55)';
    const bord = active ? 'rgba(255,106,0,0.4)'  : 'rgba(124,106,247,0.22)';
    const numC = active ? '#fff7e6' : '#a78bfa';
    const bw = 120, bh = 96;
    ctx.fillStyle = bg;
    canvasRoundRect(ctx, cx-bw/2, cy-bh/2, bw, bh, 12); ctx.fill();
    ctx.strokeStyle = bord; ctx.lineWidth = 1;
    canvasRoundRect(ctx, cx-bw/2, cy-bh/2, bw, bh, 12); ctx.stroke();

    // Flame emoji layer (simulated with gradient circle)
    const fGrad = ctx.createRadialGradient(cx, cy-12, 4, cx, cy-12, 26);
    if (active) {
      fGrad.addColorStop(0, '#ffd200'); fGrad.addColorStop(0.5, '#ff6a00'); fGrad.addColorStop(1, 'rgba(238,9,121,0)');
    } else {
      fGrad.addColorStop(0, '#3d2060'); fGrad.addColorStop(0.5, '#2a1540'); fGrad.addColorStop(1, 'transparent');
    }
    ctx.fillStyle = fGrad;
    ctx.beginPath(); ctx.ellipse(cx, cy-10, 22, 28, 0, 0, Math.PI*2); ctx.fill();

    // Streak number
    ctx.font = 'bold 32px sans-serif'; ctx.fillStyle = numC; ctx.textAlign = 'center';
    if (active) ctx.shadowColor = '#ff6a00', ctx.shadowBlur = 12;
    ctx.fillText(streak, cx, cy+4);
    ctx.shadowBlur = 0;

    // Labels
    ctx.font = '10px sans-serif'; ctx.fillStyle = '#9094b8';
    ctx.fillText(label, cx, cy+22);
    ctx.font = 'bold 10px sans-serif'; ctx.fillStyle = '#f0c040';
    ctx.fillText('Best: ' + best, cx, cy+36);
  }
  drawFlameBlock(W/4, 158, sh.streak||0, sh.best||0, '📅 Daily Hard', hardToday);
  drawFlameBlock(W*3/4, 158, se.streak||0, se.best||0, '🌿 Daily Easy', easyToday);

  // Divider
  ctx.strokeStyle = '#2a2d45'; ctx.lineWidth = 1;
  ctx.beginPath(); ctx.moveTo(36, 214); ctx.lineTo(W-36, 214); ctx.stroke();

  // ── Wins ──
  ctx.font = 'bold 10px sans-serif'; ctx.fillStyle = '#9094b8'; ctx.textAlign = 'center';
  ctx.fillText('🏆  ALL-TIME WINS', W/2, 234);
  const winRows = [
    {x:W/6,   val:sh.wins||0,  lab:'Hard Wins',   col:'#f0c040'},
    {x:W/2,   val:se.wins||0,  lab:'Easy Wins',   col:'#22c55e'},
    {x:W*5/6, val:fs.wins||0,  lab:'Free Wins',   col:'#a78bfa'},
  ];
  winRows.forEach(d => {
    // tile
    ctx.fillStyle = '#13141f';
    canvasRoundRect(ctx, d.x-46, 246, 92, 58, 10); ctx.fill();
    ctx.strokeStyle = '#2a2d45'; ctx.lineWidth = 1;
    canvasRoundRect(ctx, d.x-46, 246, 92, 58, 10); ctx.stroke();
    ctx.font = 'bold 28px sans-serif'; ctx.fillStyle = d.col; ctx.textAlign = 'center';
    ctx.fillText(d.val, d.x, 280);
    ctx.font = '9px sans-serif'; ctx.fillStyle = '#9094b8';
    ctx.fillText(d.lab, d.x, 296);
  });

  // Divider
  ctx.strokeStyle = '#2a2d45'; ctx.lineWidth = 1;
  ctx.beginPath(); ctx.moveTo(36, 318); ctx.lineTo(W-36, 318); ctx.stroke();

  // ── Accuracy ──
  ctx.font = 'bold 10px sans-serif'; ctx.fillStyle = '#9094b8'; ctx.textAlign = 'center';
  ctx.fillText('🎯  ACCURACY', W/2, 338);

  const accRows = [
    {label:'Daily Hard', wins:sh.wins||0, played:sh.played||0, c1:'#f0c040', c2:'#f97316'},
    {label:'Daily Easy', wins:se.wins||0, played:se.played||0, c1:'#22c55e', c2:'#34d399'},
    {label:'Free Mode',  wins:fs.wins||0, played:fs.played||0, c1:'#7c6af7', c2:'#a78bfa'},
  ];
  const bX = 170, bW = W - bX - 72;
  accRows.forEach((d, i) => {
    const y = 356 + i * 32;
    const p = d.played ? Math.round((d.wins/d.played)*100) : 0;
    ctx.textAlign = 'left'; ctx.font = '11px sans-serif'; ctx.fillStyle = '#9094b8';
    ctx.fillText(d.label, 40, y+8);
    // bar bg
    ctx.fillStyle = '#1a1c2e';
    canvasRoundRect(ctx, bX, y, bW, 8, 4); ctx.fill();
    // bar fill
    if (p > 0) {
      const bg = ctx.createLinearGradient(bX, y, bX+bW, y);
      bg.addColorStop(0, d.c1); bg.addColorStop(1, d.c2);
      ctx.fillStyle = bg;
      canvasRoundRect(ctx, bX, y, bW*(p/100), 8, 4); ctx.fill();
    }
    ctx.textAlign = 'right'; ctx.font = 'bold 11px sans-serif'; ctx.fillStyle = '#e8e9f3';
    ctx.fillText(d.played ? p+'%' : '—', W-36, y+8);
  });

  // Overall accuracy
  const totW = (sh.wins||0)+(se.wins||0)+(fs.wins||0);
  const totP = (sh.played||0)+(se.played||0)+(fs.played||0);
  const ovPct = totP ? Math.round((totW/totP)*100) : null;
  ctx.textAlign = 'center';
  ctx.font = 'bold 13px sans-serif'; ctx.fillStyle = '#a78bfa';
  ctx.fillText('Overall: ' + (ovPct !== null ? ovPct+'%' : '—'), W/2, 462);

  // Footer
  ctx.font = '10px sans-serif'; ctx.fillStyle = '#4a4d6a';
  ctx.fillText('histoquest – ' + today, W/2, 478);
  ctx.fillText('questions@histoquest.com', W/2, 492);

  // Trigger download
  const a = document.createElement('a');
  a.download = 'histoquest-stats-' + today + '.png';
  a.href = canvas.toDataURL('image/png');
  a.click();
  showToast('💾 Stats image saved!');
}

// ── Copy shareable link ──
function copyStatsLink() {
  const today = todayStr();
  const sh = getStats('hard'), se = getStats('easy'), fs = getFreeStats();
  const payload = {
    v: 1, date: today,
    hard: { streak: sh.streak||0, best: sh.best||0, wins: sh.wins||0, played: sh.played||0, playedToday: !!getDailyResult('hard', today) },
    easy: { streak: se.streak||0, best: se.best||0, wins: se.wins||0, played: se.played||0, playedToday: !!getDailyResult('easy', today) },
    free: { wins: fs.wins||0, played: fs.played||0 },
  };
  const encoded = btoa(unescape(encodeURIComponent(JSON.stringify(payload))));
  const base = window.location.href.split('#')[0];
  const link = base + '#share=' + encoded;
  navigator.clipboard.writeText(link)
    .then(() => showToast('🔗 Shareable link copied!'))
    .catch(() => {
      const ta = document.createElement('textarea');
      ta.value = link; document.body.appendChild(ta); ta.select();
      try { document.execCommand('copy'); showToast('🔗 Link copied!'); } catch{}
      document.body.removeChild(ta);
    });
}

// ── Shared stats view (URL hash decode) ──
function checkSharedStats() {
  const hash = window.location.hash;
  if (!hash.startsWith('#share=')) return;
  try {
    const raw = decodeURIComponent(escape(atob(hash.slice(7))));
    const data = JSON.parse(raw);
    if (data.v !== 1) return;
    // Clear hash without reload
    history.replaceState(null, '', window.location.pathname);
    buildSharedStatsModal(data);
  } catch(e) { console.warn('HistoQuest: invalid share link', e); }
}

function buildSharedStatsModal(data) {
  const hardActive = data.hard.playedToday;
  const easyActive = data.easy.playedToday;
  function acc(w, p) { return p ? Math.round((w/p)*100)+'%' : '—'; }
  function bar(pn) { return p => p ? Math.round((p.wins/p.played)*100) : 0; }
  const totW = data.hard.wins + data.easy.wins + data.free.wins;
  const totP = data.hard.played + data.easy.played + data.free.played;
  const ovPct = totP ? Math.round((totW/totP)*100)+'%' : '—';

  function flameCard(label, streak, best, active) {
    const bg = active ? 'rgba(255,106,0,0.1)' : 'rgba(42,21,64,0.55)';
    const bd = active ? 'rgba(255,106,0,0.38)' : 'rgba(124,106,247,0.2)';
    const nc = active ? '#fff7e6' : '#a78bfa';
    const ns = active ? 'text-shadow:0 0 16px #ff6a00,0 0 30px #ffd200' : 'text-shadow:0 0 10px rgba(124,106,247,.4)';
    const em = active ? '🔥' : '🌑';
    return `<div style="background:${bg};border:1px solid ${bd};border-radius:14px;padding:18px 22px;text-align:center;min-width:128px">
      <div style="font-size:.65rem;font-weight:700;text-transform:uppercase;letter-spacing:.8px;color:#9094b8;margin-bottom:6px">${label}</div>
      <div style="font-size:2rem;opacity:${active?1:.32}">${em}</div>
      <div style="font-size:2.6rem;font-weight:800;${ns};color:${nc};line-height:1;margin-top:4px">${streak}</div>
      <div style="font-size:.6rem;color:#9094b8;margin-top:2px">day streak</div>
      <div style="font-size:.68rem;font-weight:700;color:#f0c040;margin-top:5px">Best: ${best}</div>
    </div>`;
  }
  function tile(val, label, color) {
    return `<div style="background:#1a1c2e;border:1px solid #2a2d45;border-radius:10px;padding:12px;text-align:center">
      <div style="font-size:1.7rem;font-weight:800;color:${color};line-height:1">${val}</div>
      <div style="font-size:.6rem;color:#9094b8;font-weight:600;text-transform:uppercase;letter-spacing:.3px;margin-top:4px">${label}</div>
    </div>`;
  }
  function barRow(label, wins, played, c1, c2) {
    const pct = played ? Math.round((wins/played)*100) : 0;
    const str = played ? pct+'%' : '—';
    return `<div style="display:flex;align-items:center;gap:10px;margin-bottom:8px">
      <div style="font-size:.74rem;color:#9094b8;font-weight:600;min-width:82px">${label}</div>
      <div style="flex:1;height:7px;background:#1a1c2e;border-radius:999px;overflow:hidden;border:1px solid #2a2d45">
        <div style="height:100%;width:${pct}%;background:linear-gradient(90deg,${c1},${c2});border-radius:999px"></div></div>
      <div style="font-size:.78rem;font-weight:700;min-width:32px;text-align:right;color:#e8e9f3">${str}</div>
    </div>`;
  }

  const overlay = document.createElement('div');
  overlay.id = 'sharedOverlay';
  overlay.style.cssText = 'position:fixed;inset:0;z-index:700;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,.82);backdrop-filter:blur(8px)';
  overlay.innerHTML = `
    <div style="background:#13141f;border:1px solid #2a2d45;border-radius:20px;width:min(620px,95vw);max-height:90vh;overflow-y:auto;box-shadow:0 30px 90px rgba(0,0,0,.8);animation:fadeUp .35s ease;font-family:'Outfit',sans-serif">
      <div style="padding:20px 26px 14px;border-bottom:1px solid #2a2d45;display:flex;align-items:center;justify-content:space-between;flex-shrink:0">
        <div>
          <div style="font-family:'Cinzel',serif;font-size:1.1rem;font-weight:700;background:linear-gradient(135deg,#f0c040,#f97316,#a78bfa);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;letter-spacing:1px">📊 Shared Stats</div>
          <div style="font-size:.7rem;color:#9094b8;margin-top:4px">Shared on ${data.date}</div>
        </div>
        <button id="sharedClose" style="background:none;border:none;color:#9094b8;font-size:1.3rem;cursor:pointer;padding:4px">✕</button>
      </div>
      <div style="padding:24px 26px 28px;display:flex;flex-direction:column;gap:22px">
        <div>
          <div style="font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.8px;color:#9094b8;margin-bottom:14px">🔥 Current Streaks</div>
          <div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap">
            ${flameCard('📅 Daily Hard', data.hard.streak, data.hard.best, hardActive)}
            ${flameCard('🌿 Daily Easy', data.easy.streak, data.easy.best, easyActive)}
          </div>
        </div>
        <div>
          <div style="font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.8px;color:#9094b8;margin-bottom:12px">🏆 All-Time Wins</div>
          <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px">
            ${tile(data.hard.wins, 'Hard Wins', '#f0c040')}
            ${tile(data.easy.wins, 'Easy Wins', '#22c55e')}
            ${tile(data.free.wins, 'Free Wins', '#a78bfa')}
            ${tile(data.hard.played, 'Hard Played', '#e8e9f3')}
            ${tile(data.easy.played, 'Easy Played', '#e8e9f3')}
            ${tile(data.free.played, 'Free Played', '#e8e9f3')}
          </div>
        </div>
        <div>
          <div style="font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.8px;color:#9094b8;margin-bottom:12px">🎯 Win Accuracy</div>
          ${barRow('Daily Hard', data.hard.wins, data.hard.played, '#f0c040','#f97316')}
          ${barRow('Daily Easy', data.easy.wins, data.easy.played, '#22c55e','#34d399')}
          ${barRow('Free Mode',  data.free.wins,  data.free.played,  '#7c6af7','#a78bfa')}
          <div style="margin-top:8px;padding-top:10px;border-top:1px solid #2a2d45;display:flex;align-items:center;justify-content:space-between">
            <span style="font-size:.82rem;font-weight:700;color:#e8e9f3">Overall</span>
            <span style="font-size:1.1rem;font-weight:800;color:#a78bfa">${ovPct}</span>
          </div>
        </div>
        <div style="text-align:center">
          <button id="sharedBack" style="background:#1a1c2e;border:1px solid #2a2d45;color:#9094b8;border-radius:8px;padding:10px 26px;font-family:'Outfit',sans-serif;font-size:.86rem;cursor:pointer;transition:all .2s">← Back to Game</button>
        </div>
      </div>
    </div>`;
  document.body.appendChild(overlay);
  function closeShared() { overlay.remove(); }
  document.getElementById('sharedClose').addEventListener('click', closeShared);
  document.getElementById('sharedBack').addEventListener('click', closeShared);
  overlay.addEventListener('click', e => { if (e.target === overlay) closeShared(); });
}

